# Copy to .env (local) and set the same names in your host's Environment Variables (never commit .env)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
NEXTAUTH_URL="http://localhost:3000"          # on the host: https://your-site.example
NEXTAUTH_SECRET="paste-a-long-random-string"   # generate with: openssl rand -base64 32
# Optional: when set, people need this code to sign up (good for a pilot)
SIGNUP_CODE=""
