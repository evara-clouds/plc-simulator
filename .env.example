# Copy to .env (local) and set the same names in your host's Environment Variables.
# NEVER commit .env: it contains real secrets.

# ---- Required ----
# Postgres (Supabase). Port 6543 = transaction pooler (runtime), 5432 = session pooler (migrations / db push)
DATABASE_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@<region>.pooler.supabase.com:5432/postgres"

# Auth (next-auth)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="paste-a-long-random-string"   # generate with: openssl rand -base64 32

# ---- Optional ----
# Only people with this invite code can register (leave empty for open sign-up)
SIGNUP_CODE=""

# Comma-separated emails allowed to use /trainer (create classes, see progress, download CSV)
TRAINER_EMAILS=""

# Quote / pilot requests from /schools and /employers are only logged unless this is set.
# Point it at a Slack- or Discord-style incoming webhook so you actually receive them.
QUOTE_WEBHOOK_URL=""

# Shown on the About / Privacy / Contact pages
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_OPERATOR=""
NEXT_PUBLIC_DEMO_VIDEO=""
